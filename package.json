{
  "name": "farma-system",
  "private": true,
  "version": "0.0.0",
  "packageManager": "pnpm@12.11.2",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "pnpm registry:build && pnpm --filter @farma/cli build",
    "registry:build": "pnpm --filter @farma/registry build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "storybook": "pnpm --filter @farma/storybook storybook",
    "farma-system": "node packages/cli/dist/index.js",
    "storybook:build": "pnpm --filter @farma/storybook build",
    "ui:build": "pnpm registry:build && pnpm --filter @carlosmedina06/farma-ui build",
    "ui:pack": "pnpm registry:build && pnpm --filter @carlosmedina06/farma-ui pack:local",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "pnpm registry:build && changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.1",
    "typescript": "~6.0.3"
  }
}
